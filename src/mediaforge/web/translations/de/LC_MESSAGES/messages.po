# ── settings.html: Captcha / Browser + Restart ──
#: src/mediaforge/web/templates/settings.html:1310
msgid "Captcha / Browser"
msgstr "Captcha / Browser"

#: src/mediaforge/web/templates/settings.html:1314
msgid ""
"Persistent browser profile (keeps a warm Cloudflare trust for captcha "
"solving)"
msgstr ""
"Persistentes Browser-Profil (hält den Cloudflare-Trust fürs Captcha-Lösen"
" warm)"

#: src/mediaforge/web/templates/settings.html:1318
msgid ""
"Reuses one Chromium profile across captcha solves so a once-earned "
"Cloudflare trust (cf_clearance) and browser fingerprint survive. This "
"raises the Turnstile success rate. Applies on the next captcha; a restart"
" guarantees a clean state."
msgstr ""
"Verwendet ein einziges Chromium-Profil für alle Captcha-Lösungen wieder, "
"sodass ein einmal erhaltener Cloudflare-Trust (cf_clearance) und der "
"Browser-Fingerprint erhalten bleiben. Das erhöht die Turnstile-"
"Erfolgsquote. Wirkt beim nächsten Captcha; ein Neustart sorgt für einen "
"sauberen Zustand."

# -- settings.html: Captcha options --
#: src/mediaforge/web/templates/settings.html:1320
msgid "Captcha options"
msgstr "Captcha-Optionen"

#: src/mediaforge/web/templates/settings.html:1324
msgid ""
"Solve manually (no auto-click) — only your own click on the checkbox "
"counts"
msgstr ""
"Manuell lösen (kein Auto-Klick) — nur dein eigener Klick auf die Checkbox"
" zählt"

#: src/mediaforge/web/templates/settings.html:1328
msgid "Show the captcha window on screen (do not move it off-screen)"
msgstr "Captcha-Fenster sichtbar zeigen (nicht off-screen schieben)"

#: src/mediaforge/web/templates/settings.html:1332
msgid "Network ad-blocker active (turn off if the captcha does not load)"
msgstr "Netzwerk-Adblocker aktiv (abschalten, falls das Captcha nicht lädt)"

#: src/mediaforge/web/templates/settings.html:1336
msgid "Ad-tab guard active (auto-closes pop-up ad tabs)"
msgstr "Ad-Tab-Wächter aktiv (schließt Werbe-Tabs automatisch)"

#: src/mediaforge/web/templates/settings.html:1340
msgid "Ad-overlay remover active (recommended — off can let clicks be hijacked)"
msgstr "Ad-Overlay-Entferner aktiv (empfohlen — aus kann Klicks kapern)"

#: src/mediaforge/web/templates/settings.html:1344
msgid "User-agent sync active (recommended — keeps the cf_clearance cookie valid)"
msgstr "User-Agent-Sync aktiv (empfohlen — hält das cf_clearance-Cookie gültig)"

#: src/mediaforge/web/templates/settings.html:1348
msgid "WebGL renderer spoof (only useful on servers/Docker without a GPU)"
msgstr "WebGL-Renderer-Spoof (nur auf Servern/Docker ohne GPU sinnvoll)"

#: src/mediaforge/web/templates/settings.html:1351
msgid "Captcha timeout (seconds, empty = default)"
msgstr "Captcha-Timeout (Sekunden, leer = Standard)"

#: src/mediaforge/web/templates/settings.html:1356
msgid "Clear browser profile"
msgstr "Browser-Profil löschen"

#: src/mediaforge/web/templates/settings.html:1359
msgid ""
"If Turnstile keeps failing (red cross), delete the profile and solve one "
"captcha manually in the web UI to seed a fresh trust."
msgstr ""
"Wenn Turnstile ständig fehlschlägt (rotes Kreuz), lösche das Profil und "
"löse ein Captcha manuell in der WebUI, um einen frischen Trust "
"aufzubauen."

#: src/mediaforge/web/templates/settings.html:1366
msgid "Web Server"
msgstr "Web-Server"

#: src/mediaforge/web/templates/settings.html:1367
msgid "Base URL (Reverse Proxy)"
msgstr "Basis-URL (Reverse Proxy)"

#: src/mediaforge/web/templates/settings.html:1373
msgid ""
"Public URL when MediaForge runs behind a reverse proxy (e.g. Nginx, "
"Traefik). Required for OIDC callbacks and absolute links. Leave empty if "
"no proxy is used."
msgstr ""
"Öffentliche URL wenn MediaForge hinter einem Reverse Proxy läuft (z.B. "
"Nginx, Traefik). Wird für OIDC-Callbacks und absolute Links benötigt. "
"Leer lassen wenn kein Proxy verwendet wird."

#: src/mediaforge/web/templates/settings.html:1374
msgid "Changes take effect after the next restart."
msgstr "Änderungen werden nach dem nächsten Neustart wirksam."

#: src/mediaforge/web/templates/settings.html:1392
msgid "User Management"
msgstr "Benutzerverwaltung"

#: src/mediaforge/web/templates/settings.html:1394
msgid "Add User"
msgstr "Benutzer hinzufügen"

#: src/mediaforge/web/templates/settings.html:1415
msgid "Created"
msgstr "Erstellt"

#: src/mediaforge/web/templates/settings.html:1428
msgid "Groups & Permissions"
msgstr "Gruppen & Berechtigungen"

#: src/mediaforge/web/templates/settings.html:1430
msgid ""
"The three built-in groups (Administrator, User, Kids) cannot be edited or"
" removed — they define what the roles mean app-wide. Custom groups are "
"additive: a member keeps everything their role grants and gains what the "
"group adds. If a group names specific library locations, its members are "
"restricted to those."
msgstr ""
"Die drei eingebauten Gruppen (Administrator, Benutzer, Kinder) lassen "
"sich nicht bearbeiten oder löschen — sie legen app-weit fest, was die "
"Rollen bedeuten. Eigene Gruppen kommen hinzu: Mitglieder behalten alles, "
"was ihre Rolle gewährt, und bekommen dazu, was die Gruppe ergänzt. Nennt "
"eine Gruppe bestimmte Bibliotheksorte, sind ihre Mitglieder auf diese "
"beschränkt."

#: src/mediaforge/web/templates/settings.html:1436
#: src/mediaforge/web/templates/settings.html:2157
msgid "New group"
msgstr "Neue Gruppe"

#: src/mediaforge/web/templates/settings.html:1441
