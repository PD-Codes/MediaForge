"Connect MediaForge with an external identity provider (Keycloak, "
"Authentik, Google, etc.)."
msgstr ""
"Verbinde MediaForge mit einem externen Identity-Provider (Keycloak, "
"Authentik, Google, etc.)."

#: src/mediaforge/web/templates/settings.html:1444
msgid "Changes require a server restart."
msgstr "Änderungen erfordern einen Neustart des Servers."

#: src/mediaforge/web/templates/settings.html:1450
msgid "Enable SSO login"
msgstr "SSO-Login aktivieren"

#: src/mediaforge/web/templates/settings.html:1454
msgid "SSO only (disable local logins)"
msgstr "Nur SSO (lokale Logins deaktivieren)"

#: src/mediaforge/web/templates/settings.html:1481
