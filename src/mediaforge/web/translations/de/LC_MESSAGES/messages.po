msgstr "Episode (&lt;name&gt;.nfo)"

#: src/mediaforge/web/templates/integrations.html:1224
msgid "Movie (movie.nfo / &lt;name&gt;.nfo)"
msgstr "Film (movie.nfo / &lt;name&gt;.nfo)"

#: src/mediaforge/web/templates/integrations.html:1233
msgid "Enable Movie Subfolders"
msgstr "Film-Unterordner aktivieren"

#: src/mediaforge/web/templates/integrations.html:1234
msgid ""
"Each movie gets its own subfolder (Synchronized with global download "
"settings)."
msgstr ""
"Jeder Film bekommt seinen eigenen Unterordner (Synchronisiert mit den "
"globalen Download-Einstellungen)."

