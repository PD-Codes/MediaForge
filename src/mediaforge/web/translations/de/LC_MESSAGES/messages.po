msgstr "Admin-Benutzername (SSO)"

#: src/mediaforge/web/templates/settings.html:1485
msgid "Admin subject (sub claim)"
msgstr "Admin-Subject (sub claim)"

#: src/mediaforge/web/templates/settings.html:1486
msgid "UUID from the identity provider"
msgstr "UUID aus dem Identity-Provider"

#: src/mediaforge/web/templates/settings.html:1490
msgid ""
"The sub claim is more secure than the username. Found in server logs "
"after the first SSO login."
msgstr ""
"Der sub claim ist sicherer als der Benutzername. Zu finden in den Server-"
"Logs nach dem ersten SSO-Login."

#: src/mediaforge/web/templates/settings.html:1495
msgid "Save SSO settings"
msgstr "SSO-Einstellungen speichern"

#: src/mediaforge/web/templates/settings.html:1497
