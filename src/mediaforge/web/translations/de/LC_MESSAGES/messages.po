msgstr "Release öffnen"

# --- Self-update feature (added) ---
#: src/mediaforge/web/templates/settings.html:1743
msgid "Install update now"
msgstr "Update jetzt installieren"

#: src/mediaforge/web/templates/settings.html:1748
